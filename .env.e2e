# 端對端測試（Playwright）的網站設定：APP_ENV=e2e 時 Laravel 讀這個檔案而不是 .env。
# 使用獨立的資料庫，每次測試前重建；金鑰與帳密僅供測試使用。
APP_NAME="焙日"
APP_ENV=e2e
APP_KEY=base64:ZTJlLW9ubHkta2V5LW5vdC1mb3ItcHJvZHVjdGlvbiE=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001

APP_LOCALE=zh_TW
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=4

LOG_CHANNEL=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
# CI 的 MySQL 服務對應到 127.0.0.1；docker compose 的 e2e 服務以環境變數改成 mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bairi_e2e
DB_USERNAME=root
DB_PASSWORD=password

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# 綠界使用預設的測試特店；測試以 Playwright 攔下前往綠界的請求，不會真的連到綠界。
